# Settings of the prod environment on the project's VPS (docs/DEPLOYMENT.md "Demo mode and the
# installation marker"). No secrets here: they live in /opt/aap/prod/.env on the host.
# deploy.sh reads this file from the release it deploys and exports every value.
INSTANCE_ID=project-prod
# The public demo: graders switch roles via X-Demo-User-Id. Seeded data only, no real residents.
DEMO_MODE_ENABLED=true
SEED_DEMO_DATA=true
# No uploads in the public demo (epic E11).
FILES_IN_DEMO=false
# The default plugins until the building register is promoted on the owner's request.
ENABLED_PLUGINS=common.csv_export
