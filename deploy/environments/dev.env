# Settings of the dev environment on the project's VPS (docs/DEPLOYMENT.md "Demo mode and the
# installation marker"). No secrets here: they live in /opt/aap/dev/.env on the host.
# deploy.sh reads this file from the release it deploys and exports every value.
INSTANCE_ID=project-dev
# The public demo: graders switch roles via X-Demo-User-Id. Seeded data only, no real residents.
DEMO_MODE_ENABLED=true
SEED_DEMO_DATA=true
# Uploads in demo mode, so the client can be tried here (owner decision, epic E11).
FILES_IN_DEMO=true
# The Estonian building register (epic E12) on dev, to try it with the demo building.
ENABLED_PLUGINS=common.csv_export,countries.ee.building_registry
