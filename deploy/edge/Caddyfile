# Edge proxy shared by dev and prod. Certificates are issued automatically over port 80 (HTTP-01),
# so HTTPS works on any HTTPS_PORT. Hostnames and port come from /opt/aap/edge/.env.
{
	https_port {$HTTPS_PORT:443}
	servers {
		# UDP 443 (HTTP/3) may belong to other services on this host.
		protocols h1 h2
		# A slow client may not hold a connection open forever. read_body must still fit the
		# largest upload on a slow mobile link (docs/epics/E11_FILE_STORAGE.md, section 4).
		timeouts {
			read_header 10s
			read_body 3m
			idle 2m
		}
	}
}

# One environment behind the edge: {args[0]} is the backend's alias on the aap-edge network.
# Request bodies are limited here: 1 MB (decimal) for everything, raised only on the upload routes
# (E11). The backend never receives more than the limit; the client gets a bare 413 (docs/API.md,
# section 0). Refusing a large Content-Length before reading is the upload route's own job.
(environment) {
	encode zstd gzip

	# Photos of issue reports (E11 F2): JPEG of at most 2560 px, scaled by the client.
	@photo_upload {
		method POST
		path_regexp ^/api/v1/issues/[^/]+/photos$
	}
	handle @photo_upload {
		request_body {
			max_size 4MB
		}
		reverse_proxy {args[0]}:8000
	}

	# Documents of the association (E11 F3): PDF of at most 20 MB, uploaded by staff.
	@document_upload {
		method POST
		path /api/v1/documents
	}
	handle @document_upload {
		request_body {
			max_size 20MB
		}
		reverse_proxy {args[0]}:8000
	}

	handle {
		request_body {
			max_size 1MB
		}
		reverse_proxy {args[0]}:8000
	}
}

# Caddy's automatic HTTP->HTTPS redirect drops a non-default https_port, so redirect explicitly.
# ACME HTTP-01 challenges on port 80 are still answered before this route.
http://{$PROD_HOST}, http://{$DEV_HOST} {
	redir https://{host}:{$HTTPS_PORT:443}{uri} 308
}

{$PROD_HOST} {
	import environment aap-prod-backend
}

{$DEV_HOST} {
	import environment aap-dev-backend
}
