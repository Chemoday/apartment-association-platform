# Host vps1: the project's VPS (Ubuntu 24.04, 6 vCPU, 12 GB of memory, 193 GB disk; measured
# 2026-11-12). It is shared with unrelated services: an Outline VPN server holds port 443.
# Read by `bootstrap.sh --host` and `host/check.sh --host`. NO SECRETS in this file: secrets are
# generated on the host by bootstrap.sh and live only in /opt/aap/<env>/.env.

PUBLIC_IP=164.68.121.228
# 443 belongs to the VPN; move to 443 only after it is gone (docs/DEPLOYMENT.md).
HTTPS_PORT=8443
# Disk budget of the platform on this host (docs/epics/E11_FILE_STORAGE.md, section 10).
DISK_BUDGET_GB=40

# Host-wide settings: they affect every service on the host, so they stay empty until the owner of
# the host decides (docs/BACKLOG.md B-11, B-12). Examples: HOST_SWAP_SIZE=2G, HOST_JOURNAL_MAX=1G.
HOST_SWAP_SIZE=
HOST_JOURNAL_MAX=

# Images of an earlier repository name that bootstrap.sh removes (opt-in: a rollback to a commit
# before the rename on 2026-11-05 needs them). Example: ghcr.io/chemoday/ai-dev-zoomcamp-week-final
REMOVE_IMAGES_OF=
