# Optional external backend origin for local Vite dev proxy (omit to use built-in mock middleware).
# VITE_BACKEND_URL="http://localhost:8000"

# Set to "true" in strict production builds to disable browser offline demo mode.
# VITE_DISABLE_OFFLINE_DEMO="false"

# Optional release identifier included in PII-free ErrorCard diagnostics.
# VITE_APP_VERSION="0.1.0"
