{
  "name": "apartment-association-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run lint:eslint && npm run typecheck && npm run check:openapi",
    "lint:eslint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "check:openapi": "node scripts/check-openapi-schema.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.3.9",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@tabler/icons-vue": "^3.53.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.14"
  }
}
